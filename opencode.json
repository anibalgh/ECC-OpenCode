{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "plugin": [
    "./.opencode/plugins"
  ],
  "skills": {
    "paths": [
      "./skills",
      "./.agents/skills"
    ]
  },
  "agent": {
    "build": {
      "description": "Primary coding agent for development work",
      "mode": "primary",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow"
      },
      "tools": {
        "changed-files": true,
        "dependency-analyzer": true
      }
    }
  },
  "permission": {
    "mcp_*": "ask"
  }
}
